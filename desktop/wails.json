{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "VaultDock",
  "outputfilename": "VaultDock",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "VaultDock contributors",
    "email": "vaultdock@example.invalid"
  },
  "info": {
    "companyName": "VaultDock",
    "productName": "VaultDock",
    "productVersion": "0.1.0",
    "copyright": "VaultDock contributors",
    "comments": "Self-hosted file storage and intelligent synchronisation"
  },
  "nsisType": "single",
